# Copy this file to .env and adjust as needed. Vite only exposes variables
# prefixed with VITE_ to client-side code.

# 'yahoo' | 'mock'. If unset: 'mock' in dev, 'yahoo' in production builds.
# Force 'mock' anywhere (including a deployed preview) to develop/demo
# offline without hitting Yahoo Finance at all.
VITE_DATA_PROVIDER=mock
